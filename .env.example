# Copy this file to .env and fill in the values.
#   PowerShell:  Copy-Item .env.example .env
# Ask a maintainer for the real values, or read them from
# Supabase Dashboard -> Project Settings -> API.
#
# .env is gitignored - never commit real credentials.

# --- Required by the app (browser-safe: exposed to the client on purpose) ---
# These are inlined into the JS bundle at build time (NEXT_PUBLIC_ prefix),
# so `npm run build` FAILS if they are missing.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# --- Optional: only needed to apply database migrations ---
# Server-side only. This value bypasses Row Level Security - treat it as a secret.
#
# IMPORTANT: use the pooler host (IPv4), not db.<ref>.supabase.co.
# The direct host is IPv6-only, so it is unreachable on IPv4-only networks.
# The username must include the project ref: postgres.<project-ref>
# Port 5432 = session mode (use this for migrations), 6543 = transaction mode.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require